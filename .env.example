# Copy this file to .env.local and fill in real values. .env.local is
# gitignored (see .gitignore's ".env*" rule) and must never be committed.

# MongoDB Atlas connection string (Atlas dashboard -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=mobile_buzz

# Admin login (single admin account)
ADMIN_USERNAME=admin
# Generate with: npm run hash-password -- "your-password"
# (base64-encoded bcrypt hash — plain "$2b$10$..." hashes get mangled by
# Next.js's env loader, which expands "$name" as a variable reference)
ADMIN_PASSWORD_HASH_BASE64=

# Random 32+ char secret used to sign the admin session cookie.
# Generate with: openssl rand -base64 32
SESSION_SECRET=
